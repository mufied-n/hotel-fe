# Mode aplikasi: 'api' untuk production / integrasi live backend, 'mock' untuk lokal offline
NUXT_PUBLIC_BOOKING_MODE=api
NUXT_PUBLIC_OPERATIONS_MODE=api

# URL backend hotel-be (di VPS gunakan domain publik HTTPS agar dapat dijangkau oleh container FE)
NUXT_BACKEND_BASE_URL=https://hotel.fied.space

# Wajib untuk mode API. Buat random minimal 32 byte (openssl rand -base64 32), jangan commit nilai sebenarnya.
NUXT_SESSION_PASSWORD=

# Origin hosted checkout yang boleh diberikan BFF kepada browser, dipisahkan koma.
NUXT_PAYMENT_ORIGINS=https://hotel.fied.space,http://127.0.0.1:8081

# Cloudflare R2 Storage (Optional untuk proxy asset kamar dari private R2 bucket)
NUXT_R2_ACCOUNT_ID=
NUXT_R2_ACCESS_KEY_ID=
NUXT_R2_SECRET_ACCESS_KEY=
NUXT_R2_BUCKET=pulang

