# Default tetap mock. Gunakan api hanya untuk backend test yang route/migration-nya sudah cocok.
NUXT_PUBLIC_BOOKING_MODE=mock
NUXT_BACKEND_BASE_URL=http://127.0.0.1:18080

# Wajib untuk mode API. Buat random minimal 32 byte, jangan commit nilai sebenarnya.
NUXT_SESSION_PASSWORD=

# Origin hosted checkout yang boleh diberikan BFF kepada browser, dipisahkan koma.
NUXT_PAYMENT_ORIGINS=http://127.0.0.1:18080,http://localhost:18080
